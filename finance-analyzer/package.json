{
  "name": "finsecure-ai",
  "version": "1.0.0",
  "description": "AI-powered Financial Transaction Risk Intelligence and Application Security platform on SAP BTP",
  "repository": "https://github.com/example/finsecure-ai",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "dependencies": {
    "@sap/audit-logging": "^5",
    "@sap/cds": "^7.9.5",
    "@sap/cds-hana": "^2",
    "@sap/cds-mtxs": "^4",
    "@sap/logging": "^7",
    "@sap/xsenv": "^4",
    "@sap/xssec": "^3",
    "express": "^4",
    "hdb": "^0.19",
    "passport": "^0.7"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^10.1.0",
    "@types/jest": "^29",
    "@types/node": "^20",
    "fast-check": "^3",
    "jest": "^29",
    "rimraf": "^5",
    "ts-jest": "^29",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "scripts": {
    "start": "cds-serve",
    "build": "tsc && cds build",
    "watch": "cds watch",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "clean": "rimraf gen dist"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "hana",
        "impl": "@sap/cds-hana",
        "deploy-format": "hdbtable"
      },
      "auth": {
        "kind": "xsuaa"
      },
      "messaging": {
        "kind": "enterprise-messaging"
      },
      "audit-log": {
        "kind": "audit-log-service"
      },
      "multitenancy": true,
      "toggles": true,
      "extensibility": true
    },
    "hana": {
      "deploy-format": "hdbtable"
    },
    "build": {
      "target": "gen",
      "tasks": [
        {
          "for": "hana",
          "src": "db",
          "options": {
            "model": [
              "db",
              "srv"
            ]
          }
        },
        {
          "for": "node-cf",
          "src": "srv",
          "options": {
            "model": [
              "db",
              "srv"
            ]
          }
        }
      ]
    }
  },
  "engines": {
    "node": ">=18"
  }
}
