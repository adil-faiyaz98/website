{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2022",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "declaration": false,
    "noEmit": true,
    "baseUrl": ".",
    "rootDir": "./webapp",
    "paths": {
      "sap/*": [
        "./node_modules/@sapui5/types/types/sap/*",
        "./types/sap/*"
      ],
      "finsecure/ai/domaindashboards/*": [
        "./webapp/*"
      ]
    },
    "types": ["@sapui5/types"]
  },
  "include": [
    "webapp/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
