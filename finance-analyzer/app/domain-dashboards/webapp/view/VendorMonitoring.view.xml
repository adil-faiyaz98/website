<mvc:View
  controllerName="finsecure.ai.domaindashboards.controller.VendorMonitoring"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Page id="vendorPage" title="{i18n>vendorTitle}" showNavButton="true" navButtonPress=".onNavBack">
    <headerContent>
      <Button icon="sap-icon://refresh" press=".onRefresh" tooltip="{i18n>refresh}"/>
    </headerContent>
    <content>
      <VBox class="sapUiSmallMargin">
        <!-- Filter Toolbar -->
        <Toolbar>
          <SearchField id="vendorSearch" placeholder="Search vendor ID or user..." search=".onSearch" width="300px"/>
          <ToolbarSpacer/>
          <Select id="riskLevelSelect" change=".onRiskLevelFilter" forceSelection="false">
            <core:Item key="" text="All Risk Levels"/>
            <core:Item key="CRITICAL" text="Critical"/>
            <core:Item key="HIGH" text="High"/>
            <core:Item key="MEDIUM" text="Medium"/>
            <core:Item key="LOW" text="Low"/>
          </Select>
        </Toolbar>

        <!-- Vendor Bank Changes Table with Risk Indicators -->
        <Table id="vendorTable"
          items="{
            path: 'analyst>/VendorBankChanges',
            parameters: {
              $orderby: 'changedAt desc'
            }
          }"
          growing="true"
          growingThreshold="50"
          noDataText="{i18n>noData}">
          <headerToolbar>
            <OverflowToolbar>
              <Title text="{i18n>vendorTitle}" level="H3"/>
            </OverflowToolbar>
          </headerToolbar>
          <columns>
            <Column width="10%"><Text text="{i18n>vendorId}"/></Column>
            <Column width="10%"><Text text="{i18n>vendorChangingUser}"/></Column>
            <Column width="15%"><Text text="{i18n>vendorChangeTime}"/></Column>
            <Column width="12%" hAlign="Center"><Text text="{i18n>vendorRiskScore}"/></Column>
            <Column width="10%"><Text text="{i18n>vendorRiskLevel}"/></Column>
            <Column width="25%"><Text text="{i18n>vendorJustification}"/></Column>
            <Column width="18%"><Text text="{i18n>vendorCorrelatedPayment}"/></Column>
          </columns>
          <items>
            <ColumnListItem type="Active" highlight="{
              path: 'analyst>vendorRiskScore',
              formatter: '.formatter.riskScoreState'
            }">
              <cells>
                <Text text="{analyst>vendorId}"/>
                <Text text="{analyst>changingUser}"/>
                <Text text="{
                  path: 'analyst>changedAt',
                  type: 'sap.ui.model.type.DateTime',
                  formatOptions: { style: 'medium' }
                }"/>
                <ObjectNumber
                  number="{analyst>vendorRiskScore}"
                  unit="/100"
                  state="{
                    path: 'analyst>vendorRiskScore',
                    formatter: '.formatter.riskScoreState'
                  }"/>
                <ObjectStatus
                  text="{analyst>riskLevel}"
                  state="{
                    path: 'analyst>vendorRiskScore',
                    formatter: '.formatter.riskScoreState'
                  }"/>
                <Text text="{analyst>changeJustification}" wrapping="true" maxLines="2"/>
                <Text text="{analyst>correlatedPayment}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
  </Page>
</mvc:View>
