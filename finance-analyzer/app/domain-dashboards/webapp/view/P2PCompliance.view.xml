<mvc:View
  controllerName="finsecure.ai.domaindashboards.controller.P2PCompliance"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:vizData="sap.viz.ui5.data"
  xmlns:micro="sap.suite.ui.microchart">
  <Page id="p2pPage" title="{i18n>p2pTitle}" showNavButton="true" navButtonPress=".onNavBack">
    <headerContent>
      <Button icon="sap-icon://refresh" press=".onRefresh" tooltip="{i18n>refresh}"/>
    </headerContent>
    <content>
      <VBox class="sapUiSmallMargin">
        <!-- KPI Tiles Row -->
        <f:GridContainer>
          <f:items>
            <!-- Three-Way Match Rate KPI -->
            <GenericTile header="{i18n>p2pThreeWayMatch}" frameType="OneByOne" class="sapUiSmallMargin">
              <TileContent unit="%">
                <NumericContent
                  value="{viewModel>/kpis/threeWayMatchRate}"
                  valueColor="{= ${viewModel>/kpis/threeWayMatchRate} >= 95 ? 'Good' : ${viewModel>/kpis/threeWayMatchRate} >= 80 ? 'Critical' : 'Error'}"
                  scale="%"
                  indicator="{= ${viewModel>/kpis/threeWayMatchRate} >= ${viewModel>/kpis/threeWayMatchTarget} ? 'Up' : 'Down'}"/>
              </TileContent>
            </GenericTile>

            <!-- Retroactive POs KPI -->
            <GenericTile header="{i18n>p2pRetroactivePO}" frameType="OneByOne" class="sapUiSmallMargin">
              <TileContent>
                <NumericContent
                  value="{viewModel>/kpis/retroactivePOCount}"
                  valueColor="{= ${viewModel>/kpis/retroactivePOCount} === 0 ? 'Good' : ${viewModel>/kpis/retroactivePOCount} <= 5 ? 'Critical' : 'Error'}"
                  indicator="{= ${viewModel>/kpis/retroactivePOCount} === 0 ? 'None' : 'Down'}"/>
              </TileContent>
            </GenericTile>

            <!-- GR/IR Aging Average KPI -->
            <GenericTile header="{i18n>p2pGRIRAging}" subheader="Average Days" frameType="OneByOne" class="sapUiSmallMargin">
              <TileContent unit="days">
                <NumericContent
                  value="{viewModel>/kpis/grirAgingAvgDays}"
                  valueColor="{= ${viewModel>/kpis/grirAgingAvgDays} <= ${viewModel>/kpis/grirAgingThreshold} ? 'Good' : 'Error'}"
                  indicator="{= ${viewModel>/kpis/grirAgingAvgDays} <= ${viewModel>/kpis/grirAgingThreshold} ? 'Down' : 'Up'}"/>
              </TileContent>
            </GenericTile>

            <!-- Segregation Violations KPI -->
            <GenericTile header="{i18n>p2pSegregationTrends}" frameType="OneByOne" class="sapUiSmallMargin">
              <TileContent>
                <NumericContent
                  value="{viewModel>/kpis/segregationViolations}"
                  valueColor="{= ${viewModel>/kpis/segregationViolations} === 0 ? 'Good' : 'Error'}"/>
              </TileContent>
            </GenericTile>
          </f:items>
        </f:GridContainer>

        <!-- GR/IR Aging Distribution Chart -->
        <Panel headerText="GR/IR Aging Distribution" expandable="true" expanded="true" class="sapUiSmallMarginTop">
          <content>
            <viz:VizFrame id="grirAgingChart" vizType="bar" width="100%" height="300px">
              <viz:dataset>
                <vizData:FlattenedDataset data="{viewModel>/grirAgingDistribution}">
                  <vizData:dimensions>
                    <vizData:DimensionDefinition name="Age Bucket" value="{viewModel>bucket}"/>
                  </vizData:dimensions>
                  <vizData:measures>
                    <vizData:MeasureDefinition name="Count" value="{viewModel>count}"/>
                  </vizData:measures>
                </vizData:FlattenedDataset>
              </viz:dataset>
              <viz:feeds>
                <viz:ui5.controls.common.feeds.FeedItem uid="categoryAxis" type="Dimension" values="Age Bucket"/>
                <viz:ui5.controls.common.feeds.FeedItem uid="valueAxis" type="Measure" values="Count"/>
              </viz:feeds>
            </viz:VizFrame>
          </content>
        </Panel>

        <!-- Segregation Trends Chart -->
        <Panel headerText="Segregation Violation Trends" expandable="true" expanded="true" class="sapUiSmallMarginTop">
          <content>
            <viz:VizFrame id="segregationTrendsChart" vizType="timeseries_line" width="100%" height="300px">
              <viz:dataset>
                <vizData:FlattenedDataset data="{viewModel>/segregationTrends}">
                  <vizData:dimensions>
                    <vizData:DimensionDefinition name="Date" value="{viewModel>date}" dataType="date"/>
                  </vizData:dimensions>
                  <vizData:measures>
                    <vizData:MeasureDefinition name="Violations" value="{viewModel>violations}"/>
                  </vizData:measures>
                </vizData:FlattenedDataset>
              </viz:dataset>
              <viz:feeds>
                <viz:ui5.controls.common.feeds.FeedItem uid="timeAxis" type="Dimension" values="Date"/>
                <viz:ui5.controls.common.feeds.FeedItem uid="valueAxis" type="Measure" values="Violations"/>
              </viz:feeds>
            </viz:VizFrame>
          </content>
        </Panel>
      </VBox>
    </content>
  </Page>
</mvc:View>
